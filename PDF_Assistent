def load_pdf_knowledge(pdf_urls: List[str] = None, local_pdf: str = None):
    docs = []
    if pdf_urls:
        for url in pdf_urls:
            try:
                loader = OnlinePDFLoader(url)
                docs.extend(loader.load())
            except Exception as e:
                print(f"Failed to load online PDF {url}: {e}")

    if local_pdf:
        try:
            loader = PyPDFLoader(local_pdf)
            docs.extend(loader.load())
        except Exception as e:
            print(f"Failed to load local PDF {local_pdf}: {e}")

    if not docs:
        raise ValueError("No valid PDFs loaded.")

    text_splitter = RecursiveCharacterTextSplitter(chunk_size=500, chunk_overlap=50)
    texts = text_splitter.split_documents(docs)

    vector_db = FAISS.from_documents(texts, SentenceTransformerEmbeddings(model_name="all-MiniLM-L6-v2"))
    return vector_db


# Load your PDFs
pdf_urls = ["https://phi-public.s3.amazonaws.com/recipes/ThaiRecipes.pdf"]
local_pdf_path = r"D:\Projects\Agentic AI\Document\NewgenONE 2024.2 Business Workspace Administration Guide.pdf"

vector_store = load_pdf_knowledge(pdf_urls=pdf_urls, local_pdf=local_pdf_path)
retriever = vector_store.as_retriever()

llm = ChatGroq(model_name="llama3-8b-8192", temperature=0)
assistant_chain = ConversationalRetrievalChain.from_llm(llm=llm, retriever=retriever)


def pdf_assistant(new: bool = False, user: str = "user"):
    chat_history = []
    print("Assistant Ready! Type 'exit' to stop.\n")

    while True:
        query = input("Ask a question: ")
        if query.lower() == "exit":
            print("Thank you very much!")
            break

        formatted_chat_history = [(entry['question'], entry['answer']) for entry in chat_history]

        response = assistant_chain.invoke({
            "question": query,
            "chat_history": formatted_chat_history
        })

        print("\nAssistant:", response["answer"])
        chat_history.append({"question": query, "answer": response["answer"]})



if __name__ == "__main__":
    typer.run(pdf_assistant)
